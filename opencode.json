{
   "$schema":"https://opencode.ai/config.json",
   "provider":{
      "lmstudio":{
         "npm":"@ai-sdk/openai-compatible",
         "name":"LM Studio local",
         "options":{
            "baseURL":"http://127.0.0.1:1234/v1",
            "apiKey":"lmstudio-local"
         },
         "models":{
            "lmstudio":{
               "name":"IALocal",
               "limit":{
                  "context":65536,
                  "output":16384
               }
            }
         }
      }
   },
   "model":"lmstudio/Inkling 2 Mini",
   "compaction":{
      "auto":true,
      "keep":{
         "tokens":12000
      }
   }
}